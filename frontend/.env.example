# Copy to .env.local. Every variable is optional: with none set, the site runs with the
# in-browser verifier only, and /demo runs in SIM mode (clearly labelled).

# Absolute site URL, so the social card resolves (set on Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Attestor (pof-attest) ---------------------------------------------------------------
# Enables /api/attest, /api/demo-prove (the demo holder) and the attestor row on /api/status.
POF_ATTEST_URL=http://127.0.0.1:8787

# --- Solana (LIVE mode on /demo) -----------------------------------------------------------
# localnet: solana-test-validator on 127.0.0.1:8899 · devnet: https://api.devnet.solana.com
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_CLUSTER=localnet
# Printed by `node --no-warnings scripts/solana-setup.ts`
POF_POOL=
# Program ids default to the IDLs in src/data/idl; override only for a redeploy under new ids.
# POF_GATE_ID=
# POF_CREDIT_ID=

# Demo wallets: a JSON byte array (as solana-keygen writes) or base58. Never real funds.
# The relayer pays fees; the borrower is the wallet the demo proof is bound to;
# the stranger replays someone else's receipt (and must be refused).
RELAYER_SECRET_KEY=
BORROWER_SECRET_KEY=
STRANGER_SECRET_KEY=

# --- Shared store (revocations, counters, rate limits) -------------------------------------
# Vercel KV or Upstash Redis. Unset: a file in the OS temp dir and per-instance rate limits
# (fine for one server). On Vercel, POST /api/revocations answers 503 until this is set.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
